<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Pendaftaran</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
      background-size: 400% 400%;
      animation: gradientBG 15s ease infinite;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
    }

    @keyframes gradientBG {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .card-custom {
      width: 100%;
      max-width: 480px;
      border: none;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
      background: rgba(255, 255, 255, 0.95);
    }

    .btn-primary {
      background: linear-gradient(135deg, #007bff, #0056b3);
      border: none;
      border-radius: 8px;
      font-weight: 600;
    }
  </style>
</head>
<body>

  <div class="container p-3">
    <div class="card card-custom p-4 mx-auto">
      <h3 class="text-center mb-4 text-primary font-bold">Formulir Pendaftaran</h3>
      
      <div id="alertBox" class="alert d-none" role="alert"></div>

      <form id="registrationForm">
        <div class="mb-3">
          <label for="nama" class="form-label fw-semibold">Nama Lengkap</label>
          <input type="text" class="form-control" id="nama" required placeholder="Masukkan nama lengkap">
        </div>

        <div class="mb-4">
          <label for="kecamatan" class="form-label fw-semibold">Asal Kecamatan</label>
          <select class="form-select" id="kecamatan" required>
            <option value="" selected disabled>-- Pilih Kecamatan --</option>
            <option value="Kecamatan Bugul Kidul">Bugul Kidul</option>
            <option value="Kecamatan Gadingrejo">Gadingrejo</option>
            <option value="Kecamatan Panggungrejo">Panggungrejo</option>
            <option value="Kecamatan Purworejo">Purworejo</option>
          </select>
        </div>

        <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-2">Kirim Pendaftaran</button>
      </form>
    </div>
  </div>

  <script>
    // MASUKKAN URL WEB APP GOOGLE APPS SCRIPT KAMU DI SINI
    const GAS_URL = "GANTI_DENGAN_URL_WEB_APP_GAS_KAMU";

    document.getElementById("registrationForm").addEventListener("submit", function(e) {
      e.preventDefault();
      
      const btn = document.getElementById("submitBtn");
      const alertBox = document.getElementById("alertBox");
      
      btn.disabled = true;
      btn.innerText = "Mengirim...";
      alertBox.classList.add("d-none");

      const formData = {
        nama: document.getElementById("nama").value,
        kecamatan: document.getElementById("kecamatan").value
      };

      fetch(GAS_URL, {
        method: "POST",
        mode: "no-cors", // Menghindari kendala CORS pada GAS
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(formData)
      })
      .then(() => {
        btn.disabled = false;
        btn.innerText = "Kirim Pendaftaran";
        alertBox.className = "alert alert-success";
        alertBox.innerText = "Pendaftaran berhasil dikirim!";
        alertBox.classList.remove("d-none");
        document.getElementById("registrationForm").reset();
      })
      .catch(error => {
        btn.disabled = false;
        btn.innerText = "Kirim Pendaftaran";
        alertBox.className = "alert alert-danger";
        alertBox.innerText = "Gagal mengirim data. Coba lagi.";
        alertBox.classList.remove("d-none");
      });
    });
  </script>
</body>
</html>